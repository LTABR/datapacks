execute as @s at @s run function hns:functions/crawling/detect_crawling

execute store result score .speed_penalty Opcoes run data get storage options $(team).speed_penalty

$execute as @s[team=Procuradores] if predicate hns:agachando if predicate hns:stepping_on_floor unless predicate hns:correndo at @s unless entity @e[type=minecraft:text_display,distance=..$(scale)] run summon text_display ~ ~$(crouch_height) ~ {Team:"Procuradores", text:{"text":""},alignment:"left",Tags:["shulker_crawl"],Passengers:[{id:"minecraft:shulker",Team:"Procuradores",Tags:["shulker_crawl"],Silent:1b,DeathLootTable:"hns:empty",NoAI:1b,AttachFace:0b,active_effects:[{id:"minecraft:invisibility",amplifier:0b,duration:-1,show_particles:0b}],attributes:[{id:max_health,base:100000},{id:scale,base:0.01}]}]}
$execute as @s[team=Escondedores] if predicate hns:agachando if predicate hns:stepping_on_floor unless predicate hns:correndo at @s unless entity @e[type=minecraft:text_display,distance=..$(scale)] run summon text_display ~ ~$(crouch_height) ~ {Team:"Escondedores",text:{"text":""},alignment:"left",Tags:["shulker_crawl"],Passengers:[{id:"minecraft:shulker",Team:"Escondedores",Tags:["shulker_crawl"],Silent:1b,DeathLootTable:"hns:empty",NoAI:1b,AttachFace:0b,active_effects:[{id:"minecraft:invisibility",amplifier:0b,duration:-1,show_particles:0b}],attributes:[{id:max_health,base:100000},{id:scale,base:0.01}]}]}

$execute if score .elytra Opcoes matches 3 as @s[scores={crawling=1},team=Procuradores] unless predicate hns:correndo at @s run item replace entity @s armor.chest with chainmail_chestplate[minecraft:attribute_modifiers=[{type:"armor",amount:0,operation:"add_multiplied_base",id:"1",slot:"chest"},{type:"armor_toughness",amount:0,operation:"add_multiplied_base",id:"2",slot:"chest"},{type:"movement_speed",amount:-$(speed_penalty),operation:"add_multiplied_base",id:"3"}]] 1
$execute if score .elytra Opcoes matches 2 as @s[scores={crawling=1},team=Escondedores] unless predicate hns:correndo at @s run item replace entity @s armor.chest with chainmail_chestplate[minecraft:attribute_modifiers=[{type:"armor",amount:0,operation:"add_multiplied_base",id:"1",slot:"chest"},{type:"armor_toughness",amount:0,operation:"add_multiplied_base",id:"2",slot:"chest"},{type:"movement_speed",amount:-$(speed_penalty),operation:"add_multiplied_base",id:"3"}]] 1
$execute if score .elytra Opcoes matches 0 as @s[scores={crawling=1}] unless predicate hns:correndo at @s run item replace entity @s armor.chest with chainmail_chestplate[minecraft:attribute_modifiers=[{type:"armor",amount:0,operation:"add_multiplied_base",id:"1",slot:"chest"},{type:"armor_toughness",amount:0,operation:"add_multiplied_base",id:"2",slot:"chest"},{type:"movement_speed",amount:-$(speed_penalty),operation:"add_multiplied_base",id:"3"}]] 1

$execute as @s[scores={crawling=1}] unless predicate hns:correndo at @s if entity @e[type=minecraft:text_display,distance=..$(scale)] run tp @e[tag=shulker_crawl,limit=1,sort=nearest,distance=..2] ~ ~$(crouch_height) ~
