# attributes & effects
execute as @s[team=Escondedores] run damage @s 0.1 minecraft:bad_respawn_point
scoreboard players reset @a[team=Escondedores,scores={shared_lives=1..,damageTaken=1..}] damageTaken

effect give @s[team=Procuradores] minecraft:instant_health 1 200 true

execute as @s if score .VisaoNoturna Opcoes matches 1 run effect give @s minecraft:night_vision infinite 255 true

# both
execute if data entity @s Inventory[{Slot:100b}] run tag @s add has_boots
clear @s
item replace entity @s[tag=has_boots] armor.feet with minecraft:golden_boots[minecraft:enchantments={"minecraft:binding_curse":1,"minecraft:vanishing_curse":1},minecraft:tooltip_display={hidden_components:["minecraft:enchantments"]},trim={material:"minecraft:amethyst",pattern:"minecraft:silence"}]
tag @a[tag=has_boots] remove has_boots
gamemode adventure @s
execute if score .destructible_mode Opcoes matches 1 run gamemode survival @s[team=Escondedores]

item replace entity @s inventory.22 with minecraft:spyglass

scoreboard players set @s diamantes 1
schedule function hns:give/diamonds 1s append

