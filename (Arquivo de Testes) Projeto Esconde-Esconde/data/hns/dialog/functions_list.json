          {
            "text": "Normal",
            "type": "text",
            "underlined": true
          },
          "."
        ]
      },
      "action": {
        "type": "run_command",
        "command": "/function hns:start {destructible_mode:0}"
      }
    },
    {
      "label": {
        "text": "Livro de Moderador",
        "type": "text",
        "color": "gold",
        "bold": true,
        "underlined": true
      },
      "tooltip": {
        "text": "Receber Livro de Moderação.",
        "type": "text",
        "color": "gold"
      },
      "action": {
        "type": "run_command",
        "command": "/function hns:give/admin_book"
