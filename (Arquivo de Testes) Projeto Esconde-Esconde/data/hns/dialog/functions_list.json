      "action": {
        "type": "run_command",
        "command": "/function hns:configuration/set_seekers/set_seekers_list"
      }
    },
    {
      "label": {
        "text": "Selecionar Equipes",
        "type": "text",
        "color": "dark_purple"
      },
      "tooltip": {
        "text": "Habilita o Modo Duplas:\n",
        "type": "text",
        "extra": [
          {
            "text": "1.",
            "type": "text",
            "color": "gold",
            "underlined": true
          },
          {
            "text": " As Vidas dos Escondedores Serão Compartilhadas.\n",
            "underlined": false
          },
          {
            "text": "2.",
            "type": "text",
            "color": "gold",
            "underlined": true
          },
          {
            "text": " Os Pontos de Vida se Multiplicarão Pela Quantidade de Integrantes na Equipe.\n",
            "type": "text",
            "underlined": false
          },
          {
            "text": "3.",
            "type": "text",
            "color": "gold",
            "underlined": true
          },
          {
            "text": " Todos da Equipe Serão Eliminados se a Vida Zerar.\n",
            "type": "text",
            "underlined": false
          },
          {
            "text": "4.",
            "type": "text",
            "color": "gold",
            "underlined": true
          },
          {
            "text": " Nem Todos Precisam Ser Selecionados, Pessoas Individuais Jogarão Normalmente.\n",
            "type": "text",
            "underlined": false
          },
          {
            "text": "5.",
            "type": "text",
            "color": "gold",
            "underlined": true
          },
          {
            "text": " Pessoas Com Vidas Compartilhadas Vestirão Botas Como Indicação.",
            "type": "text",
            "underlined": false
          }
        ],
        "underlined": true
      },
      "action": {
        "type": "run_command",
        "command": "/function hns:configuration/set_shared_lives/set_shared_lives_list"
      }
    },
    {
      "label": {
        "text": "Configurações Atuais",
        "type": "text",
        "color": "dark_gray"
      },
      "action": {
        "type": "run_command",
        "command": "/function hns:configuration/current"
      }
    },
    {
      "label": {
        "text": "Salvar Barreira Atual",
        "type": "text",
        "color": "gold",
        "underlined": true
      },
      "tooltip": {
        "text": "Salvar Configurações e Barreira Atuais em Forma de Item.",
        "type": "text",
        "color": "gold"
      },
      "action": {
        "type": "run_command",
        "command": "/function hns:setup/barrier/item_save/create_item"
      }
    },
    {
      "label": {
        "text": "Barreira Aleatória",
        "type": "text",
        "color": "light_purple",
        "underlined": true
      },
      "tooltip": {
        "text": "Gerar Uma Barreira Aleatória.\n",
        "extra": [
          {
            "text": "ATENÇÃO: ",
            "type": "text",
            "extra": [
              {
                "text": "Este Processo Impacta Brevemente a Performance.",
                "type": "text",
                "color": "red",
                "underlined": true
              }
            ],
            "color": "dark_red"
          }
        ]
      },
      "action": {
        "type": "run_command",
        "command": "/function hns:setup/barrier/random/randomize_barrier"
      }
    },
    {
      "label": {
        "text": "Criar Backup",
        "type": "text",
        "color": "blue",
        "underlined": true
      },
      "tooltip": {
        "text": "Criar Backup da Estrutura do Mapa Atual.\n",
        "type": "text",
        "extra": [
          {
            "text": "ATENÇÃO: ",
            "type": "text",
            "color": "dark_red"
          },
          {
            "text": "Este Processo Impacta Brevemente a Performance.",
            "type": "text",
            "color": "red",
            "underlined": true
          }
        ]
      },
      "action": {
        "type": "run_command",
        "command": "/function hns:functions/create_backup_button"
      }
    },
    {
      "label": {
        "text": "[DESINSTALAR]",
        "type": "text",
        "color": "dark_red",
        "bold": true,
        "italic": true,
        "underlined": true
      },
      "width": 100,
      "tooltip": {
        "text": "Desinstala o Datapack.",
        "type": "text",
        "color": "dark_red",
        "bold": true
      },
      "action": {
        "type": "run_command",
        "command": "/tellraw @s[tag=Admin] {\"text\":\"CLIQUE PARA CONFIRMAR DESINSTALAÇÃO\",\"color\":\"dark_red\",\"bold\":true,\"underlined\":true,\"hover_event\":{\"action\":\"show_text\",\"value\":[{\"text\":\"Confirmar\\n\",\"color\":\"red\"},{\"text\":\"TODAS AS CONFIGURAÇÕES SERÃO PERDIDAS!\",\"color\":\"dark_red\",\"bold\":true,\"underlined\":true}]},\"click_event\":{\"action\":\"run_command\",\"command\":\"/function hns:setup/uninstall\"}}"
      }
    }
  ]
}
