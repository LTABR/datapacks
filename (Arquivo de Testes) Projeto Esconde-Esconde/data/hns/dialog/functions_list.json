      }
    },
    {
      "label": {
        "text": "Redefinir Lojas Normais",
        "type": "text",
        "color": "dark_aqua",
        "italic": true
      },
      "action": {
        "type": "run_command",
        "command": "/function hns:configuration/reset_shop"
      }
