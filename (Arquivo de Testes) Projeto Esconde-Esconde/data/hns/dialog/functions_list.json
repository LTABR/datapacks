    },
    {
      "label": {
        "text": "-",
        "type": "text",
        "extra": [
          {
            "text": "Modo Destrutível",
            "type": "text",
            "color": "gray",
            "bold": true,
            "underlined": true,
            "obfuscated": false
          },
          {
            "text": "-",
            "type": "text",
            "color": "white",
            "bold": true,
            "obfuscated": true
          }
        ],
        "color": "white",
        "bold": true,
        "obfuscated": true
      },
      "tooltip": {
        "text": "Inicia Uma Partida no ",
        "extra": [
          {
            "text": "Modo de Mapa Destrutível",
            "type": "text",
            "color": "gray",
            "bold": true,
            "underlined": true
          },
          "."
        ]
      },
      "action": {
        "type": "run_command",
        "command": "/function hns:start {destructible_mode:1}"
      }
    },
    {
      "label": {
        "text": "-",
        "extra": [
          {
            "text": "Configurações",
            "extra": [
              {
                "text": "-",
                "color": "dark_gray",
                "bold": true,
                "obfuscated": true
              }
